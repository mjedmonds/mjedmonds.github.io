---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import NewsList from '../components/NewsList.astro';
import PaperItem from '../components/PaperItem.astro';
import { papers } from '../lib/papers';
import { socials } from '../data/site';
---

<Base>
  <Fragment slot="masthead">
    <h1><strong>Mark</strong> Edmonds</h1>
    <p>Staff Applied Scientist at <a href="https://www.gm.com">General Motors</a> · PhD, Computer Science, UCLA</p>
  </Fragment>

  <Card class="intro">
    <div class="intro-text">
      <p>
        ML engineer, roboticist, and builder at heart. I'm interested in domains with direct societal benefits via
        applied research. I want to build a world where AI works in service of furthering human flourishing, making basic
        needs affordable, and ensuring a healthy biosphere. Let's make the future as bright as possible.
      </p>
      <p>
        I'm currently a Staff Applied Scientist at <a href="https://www.gm.com">General Motors</a>. Before that, I spent
        four years at <a href="https://getcruise.com">Cruise</a> working on machine learning for behavior planning in
        autonomous vehicles. I received my PhD in Computer Science from UCLA
        under <a href="http://www.stat.ucla.edu/~sczhu/">Dr. Song-Chun Zhu</a>, with a focus on artificial intelligence,
        robotics, and cognitive science.
      </p>
      <div class="links">
        {socials.map((s) => <a class="btn" href={s.href}>{s.label}</a>)}
      </div>
    </div>
    <figure class="intro-photo">
      <img src="/assets/img/prof_pic.jpg" alt="Mark Edmonds" width="800" height="800" />
      <figcaption>(my friends call me Marcus)</figcaption>
    </figure>
  </Card>

  <Card label="News" more={{ href: '/news/', text: 'All news' }}>
    <NewsList limit={5} />
  </Card>

  <Card label="Selected publications" more={{ href: '/publications/', text: 'All publications' }}>
    <div class="paper-list">
      {papers.filter((p) => p.selected).map((paper) => <PaperItem paper={paper} />)}
    </div>
  </Card>
</Base>
