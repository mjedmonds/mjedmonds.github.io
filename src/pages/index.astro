---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import NewsList from '../components/NewsList.astro';
import PaperItem from '../components/PaperItem.astro';
import { papers } from '../lib/papers';
import { socials } from '../data/site';
---

<Base>
  <Fragment slot="masthead">
    <h1><strong>Mark</strong> Edmonds</h1>
    <p>Staff AI/ML Applied Scientist at <a href="https://www.gm.com">General Motors</a> · PhD, Computer Science, UCLA</p>
  </Fragment>

  <Card class="intro">
    <div class="intro-text">
      <p>
        I'm a Staff AI/ML Applied Scientist at <a href="https://www.gm.com">General Motors</a>, where I build end-to-end
        driving models trained with imitation and self-play reinforcement learning. I joined GM through its acquisition
        of <a href="https://en.wikipedia.org/wiki/Cruise_(autonomous_vehicle)">Cruise</a>, where I contributed to <a href="/papers/ICML25_DriveGPT.pdf">DriveGPT</a>,
        an autoregressive behavior model that showed scaling laws for
        autonomous driving (ICML 2025), and distilled large models for deployment.
      </p>
      <p>
        My research focuses on learning-based decision-making for embodied agents: models that improve with scale,
        generalize to new situations, and can explain their behavior. I received my PhD in Computer Science from UCLA
        under <a href="https://zhusongchun.net/">Dr. Song-Chun Zhu</a>, studying causal learning, imitation learning, and
        explainable AI, with work published in <em>Science Robotics</em>, ICML, CVPR, and AAAI. I'm most motivated by
        applications with direct societal benefit, starting with safer roads.
      </p>
      <div class="links">
        {socials.map((s) => <a class="btn" href={s.href}>{s.label}</a>)}
      </div>
    </div>
    <figure class="intro-photo">
      <img src="/assets/img/prof_pic.jpg" alt="Mark Edmonds" width="800" height="800" />
      <figcaption>(my friends call me marcus)</figcaption>
    </figure>
  </Card>

  <Card label="News" more={{ href: '/news/', text: 'All news' }}>
    <NewsList limit={5} />
  </Card>

  <Card label="Selected publications" more={{ href: '/publications/', text: 'All publications' }}>
    <div class="paper-list">
      {papers.filter((p) => p.selected).map((paper) => <PaperItem paper={paper} />)}
    </div>
  </Card>
</Base>
