---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { courses } from '../../data/teaching';
---

<Base title="teaching" lead="Course materials from classes I've taught at Santa Monica College and UCLA many years ago.">
  <Card>
    <ul class="courses">
      {courses.map((course) => (
        <li>
          <h3><a href={course.href}>{course.title}</a></h3>
          {course.terms && <p class="muted">{course.terms}</p>}
          <p>{course.summary}</p>
        </li>
      ))}
    </ul>
  </Card>
</Base>
