---
import '../styles/global.css';
import { author, nav } from '../data/site';

interface Props {
  title?: string; // omitted on the home page, which fills the "masthead" slot instead
  description?: string;
  lead?: string; // shown under the page heading
}

const { title, description = 'Mark Edmonds: Staff AI/ML Applied Scientist at General Motors.', lead } = Astro.props;
const pageTitle = title ? `${title} | ${author}` : author;
const path = Astro.url.pathname;
// Project and course pages hang off publications and teaching; keep those nav items highlighted.
const section = path.startsWith('/projects/') ? '/publications/' : /^\/CS\d+\//.test(path) ? '/teaching/' : path;
const isActive = (href: string) => (href === '/' ? section === '/' : section.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/assets/img/favicon.png" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/assets/img/prof_pic.jpg', Astro.site)} />
    <!-- Apply a saved theme before first paint to avoid a flash. -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme) document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <header class:list={['masthead', { 'masthead-home': path === '/' }]}>
      <div class="container header-inner">
        <a class="site-name" href="/"><strong>Mark</strong> Edmonds</a>
        <!-- On phones the nav collapses into a menu behind this floating button. -->
        <button class="menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">☰</button>
        <nav id="site-nav">
          {nav.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
          <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
            ◐<span class="menu-only">&nbsp; theme</span>
          </button>
        </nav>
      </div>
      <div class="container masthead-text">
        <slot name="masthead">
          <h1>{title}</h1>
          {lead && <p>{lead}</p>}
        </slot>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="container site-footer">© {new Date().getFullYear()} {author}</footer>

    <script is:inline>
      document.querySelector('.theme-toggle').addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try {
          localStorage.setItem('theme', root.dataset.theme);
        } catch {}
      });

      const menuButton = document.querySelector('.menu-toggle');
      const menu = document.getElementById('site-nav');
      const setMenu = (open) => {
        menu.classList.toggle('open', open);
        menuButton.setAttribute('aria-expanded', String(open));
        menuButton.textContent = open ? '✕' : '☰';
      };
      menuButton.addEventListener('click', () => setMenu(!menu.classList.contains('open')));
      document.addEventListener('click', (e) => {
        if (!menu.contains(e.target) && e.target !== menuButton) setMenu(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setMenu(false);
      });
    </script>
  </body>
</html>
