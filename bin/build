#!/usr/bin/env bash
# Local build: Jekyll site plus legacy content, using Homebrew Ruby 3.3 if it's installed
# (macOS's system Ruby 2.6 is too old for al-folio).
#
# Usage: bin/build          build into _site
#        bin/build serve    build legacy content, then serve with live reload on :4000
set -euo pipefail

cd "$(dirname "$0")/.."
for prefix in /opt/homebrew/opt/ruby@3.3 /usr/local/opt/ruby@3.3; do
  [ -x "$prefix/bin/ruby" ] && export PATH="$prefix/bin:$PATH" && break
done
export LANG="${LANG:-en_US.UTF-8}" LC_ALL="${LC_ALL:-en_US.UTF-8}"

bundle exec jekyll build
bin/copy-legacy _site

if [ "${1:-}" = "serve" ]; then
  # keep_files in _config.yml stops rebuilds from deleting the legacy files copied above.
  bundle exec jekyll serve --skip-initial-build --livereload --livereload-port 35730
fi
